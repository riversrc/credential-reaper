# Copy to .dev.vars (gitignored) for local `wrangler dev`. Never commit real values.
#
# Leave NVIDIA_API_KEY empty to use the scripted mock provider (no network calls,
# safe for testing). A real key makes every investigation call NVIDIA Nemotron.
NVIDIA_API_KEY=

# Optional. Defaults to nvidia/nemotron-3-super-120b-a12b.
# NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# REQUIRED against a hardened SpacetimeDB module. The token of a dedicated service identity
# registered in the module's `authorized_caller` table; create one with
# spacetime/scripts/provision-worker-identity.sh (never use the database owner's token).
# Without it every request fails closed with HTTP 502.
SPACETIME_AUTH_TOKEN=
