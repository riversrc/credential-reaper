{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "credential-reaper-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Secrets (set with `wrangler secret put <NAME>`), never committed:
  //   NVIDIA_API_KEY        - NVIDIA Nemotron API key. If unset, the worker
  //                           falls back to a scripted mock agent. For local dev
  //                           put it in workers/api/.dev.vars (gitignored).
  // Optional var/secret:
  //   NEMOTRON_MODEL        - overrides the default
  //                           nvidia/nemotron-3.5-super-vl-120b-a12b
  // Required secret:
  //   SPACETIME_AUTH_TOKEN  - token of the Worker's service identity, registered
  //                           in the module's private `authorized_caller` table
  //                           (spacetime/scripts/provision-worker-identity.sh).
  //                           Without it the module returns no data and rejects
  //                           every write, so the API answers 502.
  "vars": {
    "ENVIRONMENT": "development",
    // Requires a running SpacetimeDB instance — see CLAUDE.md "Database
    // Guidelines" for the exact `spacetime start` / `spacetime publish`
    // commands. These defaults match a local `spacetime start` instance.
    "SPACETIME_URL": "http://localhost:3000",
    "SPACETIME_DB_NAME": "credential-reaper"
  }
}
